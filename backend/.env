# Server
PORT=3000
NODE_ENV=development

# Database (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin123
DB_NAME=handyhive
DB_SSL=false

# PostGIS
DB_ENABLE_POSTGIS=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload directory (change to any path on your system)
# Windows example: C:\Users\YourName\handyhive-uploads
# Linux example: /home/yourname/handyhive-uploads
# Leave empty to use ./uploads in project root
UPLOAD_DIR=
